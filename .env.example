APP_MODE=offline
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=bigquery-public-data.thelook_ecommerce
BIGQUERY_LOCATION=US
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
JWT_PUBLIC_KEY_FILE=.runtime/public.pem
JWT_TOKEN_FILE=.runtime/analyst-a.jwt
JWT_ISSUER=retail-agent-demo
JWT_AUDIENCE=retail-agent-cli
REPORTS_DB=.runtime/reports.sqlite3
MIN_AGGREGATION_GROUP_SIZE=5
MAX_BYTES_BILLED_PER_QUERY=1073741824
MAX_BYTES_BILLED_PER_TURN=4294967296
MAX_QUERY_STEPS=4
MAX_MODEL_ATTEMPTS=8
MAX_REPAIRS=2
MAX_TRANSPORT_RETRIES=2
MAX_RESULT_ROWS=200
MAX_OUTPUT_TOKENS=4096
MAX_INPUT_TOKENS_PER_TURN=24000
REQUEST_TIMEOUT_SECONDS=120
SQL_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=60
CONFIRMATION_TTL_SECONDS=300
